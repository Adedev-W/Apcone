APP_NAME=apcone

POSTGRES_USER=apcone
POSTGRES_PASSWORD=apcone_password
POSTGRES_DB=apcone
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://apcone:apcone_password@localhost:5433/apcone

REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
UPLOAD_STORAGE_DIR=storage/uploads
PDF_QUEUE_NAME=pdf_ingest
PDF_PROFILE_QUEUE_NAME=pdf_profile
PDF_FAST_QUEUE_NAME=pdf_ingest_fast
PDF_OCR_QUEUE_NAME=pdf_ingest_ocr
PDF_JOB_TIMEOUT_SECONDS=1800
PDF_RESULT_TTL_SECONDS=3600
PDF_MAX_MB=100
PDF_MAX_PAGES=500
PDF_TEXT_THRESHOLD=80
PDF_IMAGE_THRESHOLD=1
PDF_SCANNER_GRPC_URL=127.0.0.1:50051
PDF_SCANNER_LANGUAGE=eng
PDF_SCANNER_MAX_MB=100
PDF_SCANNER_TIMEOUT_SECONDS=300
PDF_SCANNER_USE_SOURCE_PATH=false
PDF_SCANNER_ALLOWED_DIR=/storage/uploads
PDF_SCANNER_WORKERS=2
PDF_SCANNER_OCR_JOBS=1
PDF_SCANNER_TESSERACT_TIMEOUT=180

QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_chunks

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
SEARCH_TOP_K=5
